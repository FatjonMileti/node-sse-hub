{
  "name": "sse-kit",
  "version": "0.1.0",
  "description": "Lightweight, framework-friendly Server-Sent Events (SSE) library for Node.js",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests examples",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{json,md}\""
  },
  "keywords": [
    "sse",
    "server-sent-events",
    "eventsource",
    "realtime",
    "streaming",
    "express",
    "fastify",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "express": "^4.21.0",
    "fastify": "^5.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3"
  }
}
