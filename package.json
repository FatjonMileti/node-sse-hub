{
  "name": "node-sse-hub",
  "version": "0.2.1",
  "description": "Hub-centric Server-Sent Events (SSE) library for Node.js: connection registry, topics, replayable history, and optional Redis clustering",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "require": "./dist/cjs/redis.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "SSE_KIT_TEST_REDIS=1 vitest run tests/redis-integration.test.ts",
    "lint": "eslint src tests examples",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{json,md}\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "sse",
    "server-sent-events",
    "eventsource",
    "realtime",
    "streaming",
    "express",
    "fastify",
    "nodejs"
  ],
  "author": "Fatjon Mileti",
  "license": "MIT",
  "homepage": "https://github.com/FatjonMileti/node-sse-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FatjonMileti/node-sse-hub.git"
  },
  "bugs": {
    "url": "https://github.com/FatjonMileti/node-sse-hub/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "peerDependencies": {
    "redis-orm-lite": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "redis-orm-lite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "express": "^4.21.0",
    "fastify": "^5.0.0",
    "node-retry-kit": "^0.1.0",
    "redis-orm-lite": "^1.1.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3"
  }
}
